<Window x:Class="SysMonBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysMonBar Settings" Width="400" Height="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F7"
        FontFamily="Segoe UI">
    
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="15,10,15,5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#D2D2D7"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5,5,5,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="5,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="HeaderStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <GroupBox Header="Modules">
                    <StackPanel>
                        <CheckBox x:Name="chkCpu" Content="Show CPU"/>
                        <CheckBox x:Name="chkGpu" Content="Show GPU"/>
                        <CheckBox x:Name="chkPower" Content="Show Power"/>
                        <CheckBox x:Name="chkTemp" Content="Show Temperature"/>
                        
                        <Separator Margin="0,10"/>
                        
                        <CheckBox x:Name="chkRam" Content="Show RAM"/>
                        <StackPanel Orientation="Horizontal" Margin="25,5,0,10">
                            <TextBlock Text="Unit: " VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton x:Name="rbRamGB" Content="GB" GroupName="RamUnit"/>
                            <RadioButton x:Name="rbRamMB" Content="MB" GroupName="RamUnit"/>
                        </StackPanel>

                        <Separator Margin="0,10"/>
                        
                        <CheckBox x:Name="chkNet" Content="Show Network"/>
                        <StackPanel Orientation="Horizontal" Margin="25,5,0,0">
                            <TextBlock Text="Unit: " VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton x:Name="rbNetKbps" Content="kbps" GroupName="NetUnit"/>
                            <RadioButton x:Name="rbNetMbps" Content="Mbps" GroupName="NetUnit"/>
                            <RadioButton x:Name="rbNetKBs" Content="KB/s" GroupName="NetUnit"/>
                            <RadioButton x:Name="rbNetMBs" Content="MB/s" GroupName="NetUnit"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="General">
                    <StackPanel>
                        <CheckBox x:Name="chkStartup" Content="Run on Windows Startup"/>

                        <Separator Margin="0,10"/>
                        
                        <TextBlock Text="Display Mode" Style="{StaticResource HeaderStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="5,5,0,10">
                            <RadioButton x:Name="rbDispGraph" Content="Graph" GroupName="DispMode"/>
                            <RadioButton x:Name="rbDispBar" Content="Bar" GroupName="DispMode"/>
                            <RadioButton x:Name="rbDispText" Content="Text" GroupName="DispMode"/>
                        </StackPanel>

                        <Separator Margin="0,10"/>
                        
                        <TextBlock Text="Graph Width (px)" Style="{StaticResource HeaderStyle}"/>
                        <Grid Margin="5,5,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="slGraphWidth" Minimum="12" Maximum="150" ValueChanged="slGraphWidth_ValueChanged"/>
                            <TextBlock x:Name="lblGraphWidth" Grid.Column="1" Text="36px" Margin="10,0,0,0" Width="40" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" BorderBrush="#D2D2D7" BorderThickness="0,1,0,0" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancel" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" Background="#E0E0E0" Click="btnCancel_Click"/>
                <Button x:Name="btnSave" Content="Save and Apply" Width="120" Height="30" Background="#0071E3" Foreground="White" BorderThickness="0" Click="btnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
