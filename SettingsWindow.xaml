<Window x:Class="SysMonBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="420" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB"
        FontFamily="Segoe UI"
        TextElement.Foreground="#111827">

    <Window.Resources>
        <!-- Card Style -->
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="20,0,20,20"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header -->
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="24,20,24,8"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- Property Label -->
        <Style TargetType="TextBlock" x:Key="PropertyLabel">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Switch Style -->
        <Style TargetType="CheckBox" x:Key="SwitchStyle">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="track" Width="44" Height="24" CornerRadius="12" Background="{TemplateBinding Background}" VerticalAlignment="Center">
                                <Ellipse x:Name="thumb" Fill="White" Width="20" Height="20" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.15" Direction="270"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Control Base -->
        <Style TargetType="Border" x:Key="SegmentContainer">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <!-- Segmented Button -->
        <Style TargetType="RadioButton" x:Key="SegmentStyle">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#111827"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.08" Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separator -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Margin" Value="0,16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,10,0,20">
                
                <TextBlock Text="MODULES" Style="{StaticResource SectionHeader}"/>
                
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <!-- CPU -->
                        <Grid>
                            <TextBlock Text="CPU" Style="{StaticResource PropertyLabel}"/>
                            <CheckBox x:Name="chkCpu" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator/>
                        
                        <!-- GPU -->
                        <Grid>
                            <TextBlock Text="GPU" Style="{StaticResource PropertyLabel}"/>
                            <CheckBox x:Name="chkGpu" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator/>
                        
                        <!-- Power -->
                        <Grid>
                            <TextBlock Text="Power" Style="{StaticResource PropertyLabel}"/>
                            <CheckBox x:Name="chkPower" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator/>
                        
                        <!-- Temperature -->
                        <Grid>
                            <TextBlock Text="Temperature" Style="{StaticResource PropertyLabel}"/>
                            <CheckBox x:Name="chkTemp" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator/>
                        
                        <!-- RAM -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Grid>
                                <TextBlock Text="RAM" Style="{StaticResource PropertyLabel}"/>
                                <CheckBox x:Name="chkRam" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <Border Grid.Row="1" Style="{StaticResource SegmentContainer}" Margin="0,12,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbRamGB" Content="GB" GroupName="RamUnit" Style="{StaticResource SegmentStyle}" MinWidth="60"/>
                                    <RadioButton x:Name="rbRamMB" Content="MB" GroupName="RamUnit" Style="{StaticResource SegmentStyle}" MinWidth="60"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Separator/>
                        
                        <!-- Network -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <TextBlock Text="Network" Style="{StaticResource PropertyLabel}"/>
                                <CheckBox x:Name="chkNet" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource SegmentContainer}" Margin="0,12,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbNetKbps" Content="kbps" GroupName="NetUnit" Style="{StaticResource SegmentStyle}" MinWidth="50"/>
                                    <RadioButton x:Name="rbNetMbps" Content="Mbps" GroupName="NetUnit" Style="{StaticResource SegmentStyle}" MinWidth="50"/>
                                    <RadioButton x:Name="rbNetKBs" Content="KB/s" GroupName="NetUnit" Style="{StaticResource SegmentStyle}" MinWidth="50"/>
                                    <RadioButton x:Name="rbNetMBs" Content="MB/s" GroupName="NetUnit" Style="{StaticResource SegmentStyle}" MinWidth="50"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="GENERAL" Style="{StaticResource SectionHeader}"/>
                
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <!-- Startup -->
                        <Grid>
                            <TextBlock Text="Run on Windows Startup" Style="{StaticResource PropertyLabel}"/>
                            <CheckBox x:Name="chkStartup" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator/>
                        
                        <!-- Display Mode -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="Display Mode" Style="{StaticResource PropertyLabel}"/>
                            
                            <Border Grid.Row="1" Style="{StaticResource SegmentContainer}" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="rbDispGraph" Content="Graph" GroupName="DispMode" Style="{StaticResource SegmentStyle}" Grid.Column="0" HorizontalContentAlignment="Center"/>
                                    <RadioButton x:Name="rbDispBar" Content="Bar" GroupName="DispMode" Style="{StaticResource SegmentStyle}" Grid.Column="1" HorizontalContentAlignment="Center"/>
                                    <RadioButton x:Name="rbDispText" Content="Text" GroupName="DispMode" Style="{StaticResource SegmentStyle}" Grid.Column="2" HorizontalContentAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Separator/>
                        
                        <!-- Graph Width -->
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Graph Width" Style="{StaticResource PropertyLabel}"/>
                                <TextBlock x:Name="lblGraphWidth" Text="36px" HorizontalAlignment="Right" Foreground="#6B7280" FontWeight="Medium"/>
                            </Grid>
                            <Slider x:Name="slGraphWidth" Minimum="12" Maximum="150" ValueChanged="slGraphWidth_ValueChanged" 
                                    IsSnapToTickEnabled="True" TickFrequency="1" Margin="-5,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnCancel" Content="Cancel" Width="90" Height="40" Background="Transparent" Foreground="#6B7280" BorderThickness="0" FontWeight="Medium" Cursor="Hand" Click="btnCancel_Click"/>
                <Button x:Name="btnSave" Content="Save and Apply" Height="40" Background="#3B82F6" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Grid.Column="1" Margin="10,0,0,0" Click="btnSave_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
