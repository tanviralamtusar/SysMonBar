<Window x:Class="SysMonBar.AnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Power Analytics" Width="540" Height="540"
        WindowStartupLocation="CenterScreen"
        Background="#2b2b2b">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#ddd"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- Period Selector -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Label Content="Period:" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbPeriod" Width="120" Margin="4,0"
                          SelectionChanged="Period_Changed">
                    <ComboBoxItem Content="24 Hours" IsSelected="True"/>
                    <ComboBoxItem Content="7 Days"/>
                    <ComboBoxItem Content="30 Days"/>
                </ComboBox>
                <Button Content="🔄 Refresh" Click="Refresh_Click"/>
            </StackPanel>

            <!-- Stats -->
            <Border Background="#333" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,4">
                        <TextBlock Text="Total kWh" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TxtKwh" Text="0.00 kWh" Foreground="#3498db" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,4">
                        <TextBlock Text="Average" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TxtAvg" Text="0 W" Foreground="#3498db" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4">
                        <TextBlock Text="Max" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TxtMax" Text="0 W" Foreground="#e74c3c" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                        <TextBlock Text="Min" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TxtMin" Text="0 W" Foreground="#2ecc71" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,4">
                        <TextBlock Text="Duration" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TxtDuration" Text="0 hours" Foreground="#ddd" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                        <TextBlock Text="Readings" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TxtReadings" Text="0" Foreground="#ddd" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chart -->
            <Border Background="#1e1e1e" CornerRadius="6" Padding="8" Margin="0,0,0,12" Height="160">
                <Canvas x:Name="ChartCanvas" ClipToBounds="True"/>
            </Border>

            <!-- Cost Calculator -->
            <Label Content="💰 Electricity Cost" FontSize="14" FontWeight="Bold" Foreground="White"/>
            <Border Background="#333" CornerRadius="6" Padding="16" Margin="0,4,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Label Content="Rate per kWh:" Width="100"/>
                        <TextBox x:Name="TxtRate" Width="80" Text="8.0"
                                 Background="#444" Foreground="White" BorderBrush="#555"
                                 Padding="4" VerticalContentAlignment="Center"/>
                        <Label Content="৳ BDT" Foreground="#888"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtCost" Text="Estimated: ৳0.00" Foreground="#e67e22"
                               FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" Background="#555"/>
        </StackPanel>
    </ScrollViewer>
</Window>
